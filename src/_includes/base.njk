<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <a class="site-title" href="/">{{ site.name }}</a>
    <nav>
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>About</a>
      <a href="/writing/"{% if page.url.startsWith("/writing/") %} aria-current="page"{% endif %}>Writing</a>
      <a href="/research/"{% if page.url == "/research/" %} aria-current="page"{% endif %}>Research</a>
      <a href="/contact/"{% if page.url == "/contact/" %} aria-current="page"{% endif %}>Contact</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
</body>
</html>
